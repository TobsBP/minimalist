  "item": [
    {
      "name": "register",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// 1. Valida se o status da resposta é 200 OK\r",
              "pm.test(\"Status code é 200 (Sucesso ao registrar)\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "// 2. Valida se o backend retornou um token JWT\r",
              "pm.test(\"Resposta possui token JWT\", function () {\r",
              "    var token = pm.response.text();\r",
              "    pm.expect(token).to.be.a('string');\r",
              "    pm.expect(token).to.not.be.empty;\r",
              "    pm.expect(token).to.match(/^eyJ/); // todo JWT começa com eyJ\r",
              "});\r",
              "\r",
              "// 3. Valida se o tempo de resposta foi saudável\r",
              "pm.test(\"Tempo de resposta menor que 500ms\", function () {\r",
              "    pm.expect(pm.response.responseTime).to.be.below(500);\r",
              "});\r",
              "\r",
              "// 4. Salva o token para uso nas próximas requisições\r",
              "var token = pm.response.text();\r",
              "pm.environment.set(\"token\", token);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
