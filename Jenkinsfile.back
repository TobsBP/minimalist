pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps { checkout scm }
        }

        stage('Back: Test') {
            steps {
                dir('back-app') {
                    sh 'chmod +x mvnw'
                    sh './mvnw test'
                }
            }
            post {
                always {
                    junit 'back-app/target/surefire-reports/*.xml'
                }
            }
        }

        stage('Back: Build') {
            steps {
                dir('back-app') {
                    sh 'chmod +x mvnw'
                    sh './mvnw package -DskipTests -q'
                }
            }
            post {
                always {
                    archiveArtifacts artifacts: 'back-app/target/*.jar', fingerprint: true
                }
            }
        }
    }
}